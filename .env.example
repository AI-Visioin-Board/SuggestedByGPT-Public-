# ============================================
# SuggestedByGPT Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ---- Database ----
DATABASE_URL=mysql://user:password@localhost:3306/suggestedbygpt

# ---- Supabase (Auth + Storage) ----
# Create a project at https://supabase.com, then get keys at: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhb...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhb...your-service-role-key

# ---- Claude API (Anthropic) ----
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ---- Stripe Payments ----
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
VITE_STRIPE_PUBLIC_KEY=pk_live_xxxxx

# ---- Email (Resend) ----
# Sign up at: https://resend.com
# Verify your domain, then get API key
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=SuggestedByGPT <hello@suggestedbygpt.com>

# ---- Auth ----
JWT_SECRET=your-random-secret-string-here

# ---- Admin ----
# Email address that gets admin role on first login
ADMIN_EMAIL=you@example.com

# ---- Portal URL ----
PORTAL_URL=https://suggestedbygpt.com/portal

# ---- VA / Service Account (Reddit + directory automation) ----
# Shared service account the automation operates under
VA_SERVICE_EMAIL=service@example.com
VA_SERVICE_PASSWORD=your-service-account-password

# ---- Reddit automation (optional) ----
WEBSHARE_API_TOKEN=your-webshare-token
ADSPOWER_API_KEY=your-adspower-local-api-key

# ---- Legacy Manus (can be removed after full migration) ----
# VITE_APP_ID=
# OWNER_OPEN_ID=
# OAUTH_SERVER_URL=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
